# Brazilian Portuguese translation for airplanemode.koplugin
# Loaded by airplanemode_i18n.lua; msgids are the English source strings in the
# plugin code. Phrasing follows KOReader's own pt_BR catalog.
# Strings KOReader already translates (About, Cancel, Close, Later, OK, Open,
# Reset, Restart, Save, Check for updates) are kept here too so the plugin reads
# the same on every KOReader build, since translations ship separately from the
# KOReader release and coverage varies between versions.
msgid ""
msgstr ""
"Project-Id-Version: airplanemode.koplugin 2.0.0\n"
"Language: pt_BR\n"
