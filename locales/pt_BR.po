"Content-Transfer-Encoding: 8bit\n"

msgid "Quickly enable/disable networking and selected plugins in one action."
msgstr "Ativa/desativa rapidamente a rede e os plugins selecionados em uma única ação."

msgid "AirPlaneMode Enable"
msgstr "AirPlaneMode: Ativar"

msgid "AirPlaneMode Disable"
msgstr "AirPlaneMode: Desativar"

msgid "AirPlaneMode Toggle"
msgstr "AirPlaneMode: Alternar"

msgid "A simple plugin that helps you when you're on the go.\n\n\nv.%1"
msgstr "Um plugin simples que ajuda quando você está a caminho.\n\n\nv.%1"

